# DeepSeek 大模型 API（必填，申请: https://platform.deepseek.com/）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# LLM 模型路由: 重任务(SemQL生成/归因结论) / 轻任务(意图/改写/精排)
LLM_MODEL_HEAVY=deepseek-v4-pro
LLM_MODEL_LIGHT=deepseek-flash
LLM_TIMEOUT_SEC=60

# 数据库路径（默认相对项目根目录）
META_DB_PATH=./data/meta.db
BIZ_DB_PATH=./test_data/data/retail.db

# 认证密钥（生产环境务必更换为随机长字符串）
AUTH_SECRET=change-me-to-a-long-random-string

# 业务时区（相对时间词按此时区展开）
TZ_NAME=Asia/Shanghai

# 洞察显著性阈值（PRD 6.6.4）：|环比%| >= INSIGHT_SIGNIFICANT_PCT 即触发归因，
# 或偏离历史均值 INSIGHT_SIGMA_K 个 σ；基线不足 6 期时只用百分比规则
INSIGHT_SIGNIFICANT_PCT=5
INSIGHT_SIGMA_K=2

# 用户记忆：会话上下文 TTL / 进程缓存容量 / 澄清选择跨会话晋升门槛
MEMORY_SESSION_TTL_HOURS=72
MEMORY_CONTEXT_CACHE_SIZE=128
MEMORY_TERM_PROMOTE_SESSIONS=3
# 长期偏好低于该有效置信度后不再使用（记忆仍保留可审计）
MEMORY_MIN_CONFIDENCE=0.35
# 显式偏好与行为推断偏好的置信度半衰期（天）
MEMORY_EXPLICIT_HALF_LIFE_DAYS=365
MEMORY_INFERRED_HALF_LIFE_DAYS=90
